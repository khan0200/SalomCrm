# Uniapp v3 Environment Configuration

# Django Settings
SECRET_KEY=django-insecure-change-this-in-production-super-secret-key-123456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_NAME=uniapp3_db
DB_USER=uniapp3_user
DB_PASSWORD=uniapp3_secret_pass
